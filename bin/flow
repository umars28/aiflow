#!/bin/sh
set -eu

AIFLOW_HOME="${AIFLOW_HOME:-$(CDPATH= cd -- "$(dirname -- "$(readlink "$0" || echo "$0")")/.." && pwd)}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/flow"
REPOS_FILE="$CONFIG_DIR/repos"
STAGES="design plan build review fix"

die() { printf 'flow: %s\n' "$1" >&2; exit 1; }
info() { printf '\033[36m▸\033[0m %s\n' "$1"; }
warn() { printf '\033[33m!\033[0m %s\n' "$1" >&2; }

need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not on PATH"; }

project_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

adapter() {
  root=$(project_root)
  test -f "$root/.aiflow/project.yaml" || die "no .aiflow/project.yaml — run 'flow init' first"
  yq -r ".$1 // \"\"" "$root/.aiflow/project.yaml"
}

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | cut -c1-32 | sed 's/^-*//; s/-*$//'
}

cmd_init() {
  forced=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --stack) forced="${2:-}"; shift 2 ;;
      --stack=*) forced="${1#--stack=}"; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  root=$(project_root)
  out="$root/.aiflow/project.yaml"
  test ! -f "$out" || die "$out already exists"

  if [ -n "$forced" ]; then
    case "$forced" in
      go)     stack=go; test="go test ./..."; lint="go vet ./..."; build="go build ./..."; chain=full ;;
      node)   stack=node; test="npm test"; lint="npm run lint --if-present"; build="npm run build --if-present"; chain=full ;;
      python) stack=python; test="pytest"; lint="ruff check ."; build=""; chain=full ;;
      rust)   stack=rust; test="cargo test"; lint="cargo clippy -- -D warnings"; build="cargo build"; chain=full ;;
      infra)  stack=infra; test=""; lint="terraform fmt -recursive -check"; build=""; chain=review ;;
      *) die "unknown stack '$forced' (go|node|python|rust|infra)" ;;
    esac
  elif [ -f "$root/go.mod" ]; then
    stack=go; test="go test ./..."; lint="go vet ./..."; build="go build ./..."; chain=full
  elif [ -f "$root/package.json" ]; then
    stack=node; test="npm test"; lint="npm run lint --if-present"; build="npm run build --if-present"; chain=full
  elif [ -f "$root/pyproject.toml" ] || [ -f "$root/requirements.txt" ]; then
    stack=python; test="pytest"; lint="ruff check ."; build=""; chain=full
  elif [ -f "$root/Cargo.toml" ]; then
    stack=rust; test="cargo test"; lint="cargo clippy -- -D warnings"; build="cargo build"; chain=full
  elif ls "$root"/*.tf >/dev/null 2>&1 || [ -d "$root/terraform" ] || [ -d "$root/kubernetes" ]; then
    stack=infra; test=""; lint="terraform fmt -recursive -check"; build=""; chain=review
  else
    die "cannot detect a stack here. For a new project say which one: flow init --stack go|node|python|rust|infra"
  fi

  mkdir -p "$root/.aiflow"
  cat > "$out" <<YAML
stack: $stack
test: $test
lint: $lint
build: $build
migrations: ""
chain: $chain
YAML

  info "detected stack: $stack"
  info "wrote .aiflow/project.yaml"
  test -n "$test" || warn "test command is empty — the build gate cannot prove anything"
  printf '\nCheck it before relying on it:\n\n'
  sed 's/^/  /' "$out"
}

cmd_new() {
  name="${1:-}"
  test -n "$name" || die "usage: flow new <name> --stack go|node|python|rust|infra [--private]"
  shift
  stack=""; visibility=--public
  while [ $# -gt 0 ]; do
    case "$1" in
      --stack) stack="${2:-}"; shift 2 ;;
      --stack=*) stack="${1#--stack=}"; shift ;;
      --private) visibility=--private; shift ;;
      --public) visibility=--public; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  test -n "$stack" || die "--stack is required for a new project"
  need gh
  need git

  owner=$(gh api user --jq .login)
  parent=$(dirname "$PWD")
  case "$PWD" in *"/$name") dir="$PWD" ;; *) dir="$PWD/$name" ;; esac
  test ! -d "$dir/.git" || die "$dir is already a git repository"

  mkdir -p "$dir"
  cd "$dir"
  git init -q -b main
  git commit -q --allow-empty -m init

  cmd_init --stack "$stack" >/dev/null
  info "adapter written for stack $stack"

  if [ "$stack" = go ] && [ ! -f go.mod ] && command -v go >/dev/null 2>&1; then
    go mod init "github.com/$owner/$name" >/dev/null 2>&1 \
      && info "go.mod created so CI is green from the first commit" \
      || warn "could not run go mod init; CI will fail until go.mod exists"
  fi

  mkdir -p .github/workflows
  if [ "$stack" = infra ]; then
    cp "$AIFLOW_HOME/templates/ai-review-only.yml" .github/workflows/ai.yml
  else
    cp "$AIFLOW_HOME/templates/ai.yml" .github/workflows/ai.yml
  fi
  if [ -f "$AIFLOW_HOME/templates/ci-$stack.yml" ]; then
    cp "$AIFLOW_HOME/templates/ci-$stack.yml" .github/workflows/ci.yml
    info "ci.yml installed for $stack"
  else
    warn "no CI template for $stack yet, only the AI workflow was installed"
  fi
  printf '* @%s\n' "$owner" > .github/CODEOWNERS
  printf '.aiflow/logs/\n' >> .gitignore
  git add -A
  git commit -q -m "ci: wire up aiflow"
  info "ai.yml installed"

  gh repo create "$owner/$name" "$visibility" --source=. --remote=origin --push >/dev/null 2>&1 \
    || die "could not create $owner/$name"
  info "pushed to github.com/$owner/$name"

  tokenfile="$CONFIG_DIR/oauth-token"
  if [ -s "$tokenfile" ]; then
    tok=$(sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' "$tokenfile" | grep -oE 'sk-ant-[A-Za-z0-9_-]+' | head -1)
    if [ "${#tok}" -lt 40 ]; then
      warn "no usable token found in $tokenfile"
      warn "run 'claude setup-token', then paste just the sk-ant-... value into that file"
    else
      printf '%s' "$tok" | gh secret set CLAUDE_CODE_OAUTH_TOKEN --repo "$owner/$name" >/dev/null 2>&1 \
        && info "secret set" || warn "could not set the secret"
    fi
  else
    warn "no token at $tokenfile, so the secret was not set"
    warn "run 'claude setup-token' once, then paste the sk-ant-... value into $tokenfile"
  fi

  gh label create ai-build --repo "$owner/$name" --color 1D76DB \
    --description "Start plan and build on this design" >/dev/null 2>&1 \
    && info "label ai-build created" || warn "could not create the ai-build label"

  gh label create ai-review --repo "$owner/$name" --color B60205 \
    --description "Found by the nightly AI review" >/dev/null 2>&1 \
    && info "label ai-review created" || warn "could not create the ai-review label"

  gh api -X PUT "repos/$owner/$name/actions/permissions/workflow" \
    -F default_workflow_permissions=read -F can_approve_pull_request_reviews=true >/dev/null 2>&1 \
    && info "actions may open pull requests" || warn "could not allow actions to open pull requests"

  printf '{"required_status_checks":null,"enforce_admins":false,"required_pull_request_reviews":{"required_approving_review_count":1,"require_code_owner_reviews":true,"dismiss_stale_reviews":true},"restrictions":null,"allow_force_pushes":false,"allow_deletions":false}' \
    | gh api -X PUT "repos/$owner/$name/branches/main/protection" --input - >/dev/null 2>&1 \
    && info "main protected, one code owner review required" \
    || warn "could not protect main (private repos need a paid plan)"

  grep -qxF "$owner/$name" "$REPOS_FILE" 2>/dev/null || printf '%s\n' "$owner/$name" >> "$REPOS_FILE"
  info "added to flow status"

  printf '\n'
  warn "one step is left and it needs a browser:"
  printf '    add %s to the Claude GitHub App\n' "$owner/$name"
  printf '    https://github.com/settings/installations\n'
  printf '    (choosing "All repositories" there removes this step for good)\n\n'
  printf '  next:  cd %s && flow run design "<what to build>"\n' "$dir"
  unset parent
}

cmd_ship() {
  need gh
  need git
  root=$(project_root)
  cd "$root"
  test -f .aiflow/02-design.md || die "no .aiflow/02-design.md — run 'flow run design' first"

  branch="${1:-}"
  if [ -z "$branch" ]; then
    branch="feat/$(slugify "$(grep -m1 -E '^#+ ' .aiflow/02-design.md | sed 's/^#* *//')")"
    test "$branch" != "feat/" || branch="feat/$(date -u +%Y%m%d%H%M%S)"
  fi

  cur=$(git rev-parse --abbrev-ref HEAD)
  if [ "$cur" = main ] || [ "$cur" = master ]; then
    git switch -q -c "$branch"
  else
    branch="$cur"
  fi

  git add .aiflow/project.yaml .aiflow/02-design.md 2>/dev/null || true
  if ! git diff --cached --quiet; then
    git commit -q -m "design: $(grep -m1 -E '^#+ ' .aiflow/02-design.md | sed 's/^#* *//' | cut -c1-60)"
  fi
  git push -q -u origin "$branch" 2>/dev/null || git push -q origin "$branch"

  url=$(gh pr view --json url --jq .url 2>/dev/null || true)
  if [ -z "$url" ]; then
    url=$(gh pr create --head "$branch" --base main \
      --title "$(grep -m1 -E '^#+ ' .aiflow/02-design.md | sed 's/^#* *//' | cut -c1-70)" \
      --body "Design is in \`.aiflow/02-design.md\`. Labelling this \`ai-build\` starts plan and build.")
  fi
  info "pull request: $url"

  gh pr edit "$url" --add-label ai-build >/dev/null \
    && info "labelled ai-build, plan and build start now" \
    || die "could not add the ai-build label"
}

cmd_run() {
  stage="${1:-}"
  test -n "$stage" || die "usage: flow run <$(echo "$STAGES" | tr ' ' '|')> [arguments]"
  shift
  case " $STAGES " in *" $stage "*) ;; *) die "unknown stage: $stage" ;; esac

  prompt="$AIFLOW_HOME/prompts/$stage.md"
  gate="$AIFLOW_HOME/gates/$stage.sh"
  test -f "$prompt" || die "prompt not found: $prompt"

  root=$(project_root)
  chain=$(adapter chain)
  if [ "$chain" = review ] && [ "$stage" != review ] && [ "$stage" != design ]; then
    die "this repo is chain:review — stage '$stage' is blocked on purpose"
  fi

  model=$(stage_model "$stage")
  turns=$(stage_turns "$stage")

  info "$stage · model $model · max-turns $turns"
  mkdir -p "$root/.aiflow/logs"
  log="$root/.aiflow/logs/$stage.log"

  st=$(mktemp)
  {
    cat "$prompt"
    if [ $# -gt 0 ]; then printf '\n\n## Arguments\n\n%s\n' "$*"; fi
  } | { claude -p --model "$model" --max-turns "$turns" --allowedTools "$(stage_tools "$stage")" 2>&1; printf '%s' "$?" > "$st"; } | tee "$log"

  code=$(cat "$st"); rm -f "$st"
  if [ "${code:-1}" -ne 0 ]; then
    warn "the agent exited with status $code"
    grep -qi "max turns" "$log" && warn "it ran out of turns; raise --max-turns or re-run to resume"
    die "stage '$stage' did not finish — not gating a partial result"
  fi

  if [ -z "$(git -C "$root" status --porcelain)" ]; then
    warn "the agent wrote nothing"
    warn "most often a PreToolUse hook blocked the writes; headless runs cannot answer a prompt"
    warn "check: jq -r '.hooks.PreToolUse' ~/.claude/settings.json"
    die "nothing to gate"
  fi

  if [ -x "$gate" ]; then
    info "gate: $(basename "$gate")"
    AIFLOW_HOME="$AIFLOW_HOME" "$gate" "$root" || die "gate '$stage' failed — chain stops here"
    info "gate passed"
  else
    warn "no gate for '$stage' — nothing proves this result"
  fi
}

stage_model() {
  case "$1" in
    review) echo claude-sonnet-5 ;;
    fix) echo claude-opus-5 ;;
    *) echo claude-opus-5 ;;
  esac
}

stage_tools() {
  case "$1" in
    design)  echo "Read,Grep,Glob,Write,Bash(go test:*),Bash(npm test:*),Bash(pytest:*),Bash(cargo test:*)" ;;
    plan)    echo "Read,Grep,Glob,Write" ;;
    build)   echo "Bash,Read,Write,Edit,Grep,Glob" ;;
    review)  echo "Bash(git:*),Bash(ls:*),Bash(cat:*),Bash(head:*),Bash(find:*),Read,Grep,Glob,Write" ;;
    fix)     echo "Bash,Read,Write,Edit,Grep,Glob" ;;
    *)       echo "Read,Grep,Glob" ;;
  esac
}

stage_turns() {
  case "$1" in
    review) echo 12 ;;
    design|plan) echo 20 ;;
    fix) echo 30 ;;
    *) echo 60 ;;
  esac
}

cmd_fan() {
  test $# -gt 0 || die "usage: flow fan \"feature a\" \"feature b\" ..."
  test $# -le 3 || die "three worktrees max — beyond that your quota and your review time are the bottleneck"
  need git

  root=$(project_root)
  base=$(basename "$root")
  cd "$root"

  i=0
  for desc in "$@"; do
    i=$((i + 1))
    slug=$(slugify "$desc")
    test -n "$slug" || die "description #$i produced no valid branch name"
    branch="ai/$slug"
    wt="$root/../$base-$slug"

    if git show-ref --verify --quiet "refs/heads/$branch"; then
      warn "branch $branch already exists — skipped"
      continue
    fi

    git worktree add -b "$branch" "$wt" HEAD >/dev/null
    info "worktree $i: $wt  ($branch)"

    mkdir -p "$wt/.aiflow/logs"
    ( cd "$wt" && "$0" run build "$desc" >"$wt/.aiflow/logs/fan.log" 2>&1 ) &
  done

  printf '\n'
  info "$# agents running in parallel. Follow them with:"
  printf '    tail -f %s/../%s-*/.aiflow/logs/fan.log\n' "$root" "$base"
  info "clean up afterwards with: flow fan-clean"
  wait
}

cmd_fan_clean() {
  root=$(project_root)
  cd "$root"
  git worktree list --porcelain | awk '/^worktree /{print $2}' | while read -r wt; do
    test "$wt" != "$root" || continue
    if [ -z "$(git -C "$wt" status --porcelain)" ]; then
      git worktree remove "$wt"
      info "removed $wt"
    else
      warn "uncommitted changes, left alone: $wt"
    fi
  done
}

repo_list() {
  if [ -n "${AIFLOW_REPOS:-}" ] && [ -f "$AIFLOW_REPOS" ]; then
    src="$AIFLOW_REPOS"
  elif [ -f "$REPOS_FILE" ]; then
    src="$REPOS_FILE"
  else
    mkdir -p "$CONFIG_DIR"
    die "no repo list yet. Create $REPOS_FILE, one owner/repo per line"
  fi
  grep -v '^[[:space:]]*\(#\|$\)' "$src"
}

collect() {
  repo_list | while IFS= read -r repo; do
    run=$(gh run list --repo "$repo" --limit 1 \
            --json status,conclusion,name,createdAt,url,headBranch \
            --jq '.[0] // empty' 2>/dev/null || true)
    prlist=$(gh pr list --repo "$repo" --state open --limit 20 \
               --json number,title,url,createdAt,isDraft \
               --jq '[.[] | select(.isDraft | not) | {number, title, url, created_at: .createdAt}]' 2>/dev/null || echo '[]')
    prs=$(printf '%s' "$prlist" | jq 'length')

    if [ -z "$run" ]; then
      printf '%s' '{}' | jq -c --arg repo "$repo" --argjson prs "$prs" \
        --argjson prlist "$prlist" \
        '{repo:$repo, state:"idle", stage:null, branch:null, created_at:null, url:null, prs:$prs, open_prs:$prlist}'
    else
      printf '%s' "$run" | jq -c --arg repo "$repo" --argjson prs "$prs" --argjson prlist "$prlist" '
        {
          repo: $repo,
          state: (
            if .status == "completed" then
              (if .conclusion == "success" then "passed"
               elif .conclusion == "failure" then "failed"
               elif .conclusion == "cancelled" then "cancelled"
               else (.conclusion // "unknown") end)
            elif .status == "in_progress" or .status == "queued" then "running"
            else .status end
          ),
          stage: .name,
          branch: .headBranch,
          created_at: .createdAt,
          url: .url,
          prs: $prs,
          open_prs: $prlist
        }'
    fi
  done
}

cmd_status() {
  need gh
  need jq

  if [ "${1:-}" = "--json" ]; then
    collect | jq -s --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{generated_at:$at, repos:.}'
    return
  fi

  printf '\n  \033[2m%-34s %-10s %-14s %-6s %s\033[0m\n' repo run stage age PRs
  printf '  \033[2m%s\033[0m\n' '──────────────────────────────────────────────────────────────────────────'

  collect | while IFS= read -r row; do
    repo=$(printf '%s' "$row" | jq -r .repo)
    state=$(printf '%s' "$row" | jq -r .state)
    stage=$(printf '%s' "$row" | jq -r '.stage // "—"' | awk '{ if (length($0) > 14) print substr($0,1,13) "…"; else print }')
    created=$(printf '%s' "$row" | jq -r '.created_at // ""')
    prs=$(printf '%s' "$row" | jq -r .prs)

    test -n "$created" && age=$(humanize_age "$created") || age='—'
    test "$prs" -gt 0 && prtxt="$prs open" || prtxt='—'

    case "$state" in
      passed)    mark='\033[32m✓\033[0m' ;;
      failed)    mark='\033[31m✗\033[0m' ;;
      cancelled) mark='\033[33m⊘\033[0m' ;;
      running)   mark='\033[36m●\033[0m' ;;
      *)         mark='\033[2m·\033[0m' ;;
    esac

    # shellcheck disable=SC2059
    printf "  %-34s $mark %-8s %-14s %-6s %s\n" "$(printf '%s' "$repo" | cut -c1-34)" "$state" "$stage" "$age" "$prtxt"
  done
  printf '\n'
}

humanize_age() {
  now=$(date -u +%s)
  then=$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null \
         || date -u -d "$1" +%s 2>/dev/null || echo "$now")
  d=$((now - then))
  if   [ "$d" -lt 60 ];    then printf '%ds' "$d"
  elif [ "$d" -lt 3600 ];  then printf '%dm' "$((d / 60))"
  elif [ "$d" -lt 86400 ]; then printf '%dh' "$((d / 3600))"
  else printf '%dd' "$((d / 86400))"
  fi
}

usage() {
  cat <<'TXT'
flow — a reusable AI workflow harness across projects

  flow new <name>        create the repo, wire CI, set the secret, register it
  flow init              detect the stack, write .aiflow/project.yaml
  flow ship              push the design, open the pull request, label it ai-build
  flow run <stage>       design | plan | build | review | fix
  flow fan "a" "b"       run several features in parallel via git worktrees
  flow fan-clean         remove worktrees that are already clean
  flow status            summary of every repo in ~/.config/flow/repos

Environment:
  AIFLOW_HOME            root of the aiflow checkout (default: relative to this script)
TXT
}

case "${1:-}" in
  new)       shift; cmd_new "$@" ;;
  ship)      shift; cmd_ship "$@" ;;
  init)      shift; cmd_init "$@" ;;
  run)       shift; cmd_run "$@" ;;
  fan)       shift; cmd_fan "$@" ;;
  fan-clean) shift; cmd_fan_clean "$@" ;;
  status)    shift; cmd_status "$@" ;;
  ''|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try 'flow help')" ;;
esac
