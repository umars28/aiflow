{
  "name": "aiflow alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.AIFLOW_STATUS_URL }}",
        "options": {}
      },
      "id": "a2222222-2222-4222-8222-222222222222",
      "name": "Fetch status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};\n\nconst out = [];\nfor (const r of data.repos || []) {\n  if (r.state !== 'failed') {\n    delete store.seen[r.repo];\n    continue;\n  }\n  if (store.seen[r.repo] === r.url) continue;\n  store.seen[r.repo] = r.url;\n\n  const short = r.repo.split('/')[1] || r.repo;\n  const where = [r.stage, r.branch].filter(Boolean).join(' on ');\n  out.push({ json: {\n    repo: r.repo,\n    text: '\\u274c <b>' + short + '</b>\\n' + where + '\\n' + (r.url || '')\n  }});\n}\nreturn out;"
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "New failures only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.text, parse_mode: 'HTML', disable_web_page_preview: true }) }}",
        "options": {}
      },
      "id": "a4444444-4444-4444-8444-444444444444",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Fetch status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch status": {
      "main": [
        [
          {
            "node": "New failures only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New failures only": {
      "main": [
        [
          {
            "node": "Notify Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "id": "aiflowAlerts0001"
}
